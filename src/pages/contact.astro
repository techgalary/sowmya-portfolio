&#x20; \<section class="contact-form-section">     \<div class="contact-form-intro">       \<p class="eyebrow">/ send a message\</p>       \<h2>Let's start a conversation.\</h2>       \<p>Tell me what you'd like to discuss, whether it's a role, a technical topic, mentorship, or collaboration.\</p>     \</div>

```
<form class="contact-form" id="contact-form">
  <label for="contact-name">Your name</label>
  <input id="contact-name" name="name" autocomplete="name" required placeholder="Your name" />

  <label for="contact-email">Email address</label>
  <input id="contact-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />

  <label for="contact-topic">Topic</label>
  <select id="contact-topic" name="topic" required>
    <option value="Project collaboration">Project collaboration</option>
    <option value="Ask Me Anything">Ask Me Anything</option>
    <option value="Job opportunity">Job opportunity</option>
    <option value="Cloud / DevOps discussion">Cloud / DevOps discussion</option>
    <option value="Career mentorship">Career mentorship</option>
    <option value="Opportunity Card experience">Opportunity Card experience</option>
    <option value="Community / collaboration">Community / collaboration</option>
    <option value="Other">Other</option>
  </select>

  <label for="contact-message">Message</label>
  <textarea id="contact-message" name="message" rows="5" required placeholder="How can I help?"></textarea>

  <button type="submit" class="contact-submit" id="contact-submit">
    Send enquiry ↗
  </button>

  <p class="note" id="contact-form-note" role="status" aria-live="polite">
    Your enquiry will be sent directly to my inbox. You won't need to open an email application.
  </p>
</form>
```

&#x20; \</section>

&#x20; \<script>
&#x20;   const form = document.querySelector\<HTMLFormElement>('#contact-form');
&#x20;   const note = document.querySelector\<HTMLElement>('#contact-form-note');
&#x20;   const submitButton = document.querySelector\<HTMLButtonElement>('#contact-submit');

&#x20;   form?.addEventListener('submit', async (event) => {
&#x20;     event.preventDefault();

&#x20;     if (!form.reportValidity()) return;

&#x20;     const originalButtonText = 'Send enquiry ↗';

&#x20;     if (submitButton) {
&#x20;       submitButton.disabled = true;
&#x20;       submitButton.textContent = 'Sending…';
&#x20;     }

&#x20;     if (note) {
&#x20;       note.textContent = 'Sending your enquiry…';
&#x20;     }

&#x20;     try {
&#x20;       const formData = new FormData(form);
&#x20;       const topic = String(formData.get('topic') || 'General enquiry');

&#x20;       formData.set('\_subject', \`[Portfolio enquiry] ${topic}\`);

&#x20;       const response = await fetch('[https://formspree.io/f/myekjnle](https://formspree.io/f/myekjnle)', {
&#x20;         method: 'POST',
&#x20;         body: formData,
&#x20;         headers: {
&#x20;           Accept: 'application/json'
&#x20;         }
&#x20;       });

&#x20;       if (!response.ok) {
&#x20;         throw new Error('The form service could not accept your enquiry.');
&#x20;       }

&#x20;       if (note) {
&#x20;         note.textContent = 'Thank you! Your enquiry has been submitted successfully. I’ll get back to you as soon as I can.';
&#x20;       }

&#x20;       form.reset();
&#x20;     } catch (error) {
&#x20;       if (note) {
&#x20;         note.textContent = 'Sorry, your enquiry could not be submitted. Please check your connection and try again, or email sowmyanx\@gmail.com directly.';
&#x20;       }
&#x20;     } finally {
&#x20;       if (submitButton) {
&#x20;         submitButton.disabled = false;
&#x20;         submitButton.textContent = originalButtonText;
&#x20;       }
&#x20;     }
&#x20;   });
&#x20; \</script>

\</BaseLayout>
