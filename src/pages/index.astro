---
import BaseLayout from '../layouts/BaseLayout.astro';
const skills = [
  { title: 'Cloud platforms', tools: ['Azure', 'Google Cloud', 'AKS', 'GKE', 'IAM', 'Networking'] },
  { title: 'Containers & platform', tools: ['Kubernetes', 'Helm', 'Argo CD', 'OpenShift', 'Rancher'] },
  { title: 'Infrastructure as code', tools: ['Terraform', 'Terragrunt', 'Reusable modules', 'Policy & state'] },
  { title: 'CI/CD & automation', tools: ['GitLab CI', 'GitHub Actions', 'GitOps', 'Release automation'] },
  { title: 'Monitoring and incident response', tools: ['Prometheus', 'Grafana', 'Dynatrace', 'Alertmanager', 'SLO / SLI'] },
  { title: 'Security & operations', tools: ['HashiCorp Vault', 'Azure Key Vault', 'Entra ID', 'Incident response'] }
];
const repos = [
  { name: 'TechGalary', desc: 'My technical learning space for cloud, DevOps, Kubernetes, and hands-on engineering guides.', tags: ['Cloud Native', 'DevOps', 'Learning'], url: 'https://github.com/Tech-Galary/' },
  { name: 'Kubernetes & Platform Labs', desc: 'A space for practical platform engineering experiments and reproducible examples.', tags: ['Kubernetes', 'Platform Engineering'], url: 'https://github.com/Tech-Galary/' },
  { name: 'Infrastructure as Code', desc: 'Terraform-focused examples and notes for repeatable cloud infrastructure.', tags: ['Terraform', 'Automation'], url: 'https://github.com/Tech-Galary/' }
];
const articles = [
  { title: 'Surviving a Kafka Production Outage on Kubernetes', category: 'PRODUCTION RELIABILITY', desc: 'Lessons from a real GCP incident, from Kafka alerts to Kubernetes troubleshooting and recovery.', href: 'https://techgalary.com/surviving-a-kafka-production-outage-on-kubernetes-lessons-from-a-real-gcp-incident' },
  { title: 'Handling Critical Container Vulnerabilities in Kubernetes', category: 'CLOUD SECURITY', desc: 'Notes on container vulnerabilities and securing Kubernetes workloads with Prisma Cloud.', href: 'https://techgalary.com/handling-critical-container-vulnerabilities-in-kubernetes-using-prisma-cloud' },
  { title: 'Troubleshooting Azure Load Balancer Data Path Availability', category: 'AZURE · NETWORKING', desc: 'A production troubleshooting case focused on Azure load balancer data-path availability.', href: 'https://techgalary.com/troubleshooting-azure-load-balancer-data-path-availability-degradation' }
];
---
<BaseLayout active="home" title="Sowmya Narayan | Senior Platform Engineer" description="Cloud infrastructure, Kubernetes, Terraform, GitOps, and reliability engineering.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> SENIOR PLATFORM / DEVOPS ENGINEER</p>
      <h1>Cloud &amp; DevOps<br /><span class="accent">with a focus on reliability.</span></h1>
      <p class="hero-text">I work with AWS, Azure, and Google Cloud to manage cloud infrastructure and support Kubernetes-based applications. I use Terraform and CI/CD automation to make deployments more consistent, and monitoring tools to investigate production issues. I’m also exploring Nextcloud and self-hosted infrastructure.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${import.meta.env.BASE_URL}projects/`}>Explore my work <span>↗</span></a>
        <a class="button button-secondary" href={`${import.meta.env.BASE_URL}consultation/`}>Let's connect</a>
      </div>
      <div class="quick-facts">
        <div><strong>Cloud platforms</strong><span>AWS · Azure · Google Cloud</span></div>
        <div><strong>Delivery automation</strong><span>Terraform · CI/CD · Kubernetes</span></div>
        <div><strong>Exploring</strong><span>Nextcloud · Self-hosting</span></div>
      </div>
    </div>
    <aside class="hero-portrait" aria-label="Portrait of Sowmya Narayan">
      <div class="portrait-frame">
        <img src={`${import.meta.env.BASE_URL}sowmya-profile.jpg`} alt="Sowmya Narayan, Senior Platform / DevOps Engineer" fetchpriority="high" />
        <div class="portrait-label"><span class="status-dot"></span><div><strong>Sowmya Narayan</strong><small>Platform Engineering · Cloud Native</small></div></div>
      </div>
      <div class="portrait-orbit orbit-one"></div>
      <div class="portrait-orbit orbit-two"></div>
      <div class="portrait-caption">BUILD · AUTOMATE · IMPROVE</div>
    </aside>
  </section>

  <section class="section about-section" id="about">
    <div class="section-heading"><div><p class="eyebrow">01 / ABOUT ME</p><h2>A little about how I work.</h2></div></div>
    <div class="about-grid">
      <div class="about-copy">
        <p class="lead">I'm Sowmya. My background is in DevOps and cloud infrastructure, with hands-on work across Kubernetes, Terraform, CI/CD, monitoring, and production support.</p>
        <p>I like work where I can understand the whole path — from infrastructure and deployment to what happens when something breaks. Here I'm collecting practical projects, notes, and examples I can share publicly.</p>
        <p>Outside work, I'm building TechGalary, attending tech community events, volunteering when I can, and looking for opportunities to contribute to open source.</p>
        <a class="text-link" href="https://techgalary.com/" target="_blank" rel="noreferrer">Explore my articles on TechGalary ↗</a>
      </div>
      <div class="about-facts">
        <div class="info-card"><span class="info-icon">↗</span><div><h3>Current focus</h3><p>Cloud-native platforms, Kubernetes operations, Terraform, GitOps, observability, and platform reliability.</p></div></div>
        <div class="info-card"><span class="info-icon">◎</span><div><h3>Community involvement</h3><p>Participating in technology conferences and volunteering at community events, while building my open-source contribution journey.</p></div></div>
        <div class="info-card"><span class="info-icon">✳</span><div><h3>Knowledge sharing</h3><p>TechGalary is my technical knowledge-sharing website, where I publish production troubleshooting stories and practical cloud and DevOps articles.</p></div></div>
      </div>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="section-heading"><div><p class="eyebrow">02 / TECHNICAL EXPERTISE</p><h2>Skills & technologies</h2><p class="section-intro">A snapshot of the tools I use in cloud and platform engineering.</p></div><a class="text-link" href="/skills/">Full skills overview ↗</a></div>
    <div class="skills-grid">
      {skills.map((s, i) => <article class="skill-card"><div class="skill-card-top"><span class="skill-number">0{i + 1}</span><span class="skill-marker">{['☁','⎈','⌘','⇄','◉','◇'][i]}</span></div><h3>{s.title}</h3><div class="tag-row">{s.tools.map((t) => <span>{t}</span>)}</div></article>)}
    </div>
  </section>

  <section class="section github-section" id="github">
    <div class="section-heading"><div><p class="eyebrow">03 / CODE & EXPERIMENTS</p><h2>From ideas to repositories.</h2><p class="section-intro">A few areas I'm documenting and developing. I'll link individual repositories as each project is ready to share.</p></div><a class="text-link" href="/github/">GitHub overview ↗</a></div>
    <div class="repo-grid">
      {repos.map((r, i) => <article class="repo-card"><div class="repo-top"><span class="repo-symbol">⌘</span><span class="repo-number">REPOSITORY / 0{i+1}</span></div><h3>{r.name}</h3><p>{r.desc}</p><div class="tag-row">{r.tags.map((t) => <span>{t}</span>)}</div><a href={r.url} class="text-link" target="_blank" rel="noreferrer">View on GitHub ↗</a></article>)}
    </div>
  </section>

  <section class="section articles-section" id="articles">
    <div class="section-heading"><div><p class="eyebrow">04 / TECHNICAL WRITING</p><h2>Real incidents. <span class="accent">Practical lessons.</span></h2><p class="section-intro">I document production issues, troubleshoot cloud and Kubernetes environments, and share the solutions and lessons learned along the way. Explore my technical articles on TechGalary.</p></div><a class="text-link" href="/blog/">All 8 articles ↗</a></div>
    <div class="article-grid">
      {articles.map((a, i) => <a class="article-card" href={a.href} target="_blank" rel="noreferrer"><span class="article-index">0{i+1}</span><span class="card-index">{a.category}</span><h3>{a.title}</h3><p>{a.desc}</p><span class="article-read">Read on TechGalary ↗</span></a>)}
    </div>
    <p class="note">Read more practical cloud and DevOps articles on <a href="https://techgalary.com/" target="_blank" rel="noreferrer">TechGalary</a>, my technical knowledge-sharing website.</p>
  </section>

  <section class="home-contact-section" id="contact">
    <div class="home-contact-inner">
      <p class="eyebrow">06 / LET'S CONNECT</p>
      <h2>Let’s connect</h2>
      <p class="home-contact-copy">Interested in cloud and DevOps collaboration, technical communities, or just want to say hi? I’d love to connect.</p>
      <div class="home-contact-actions">
        <a class="button button-primary email-me-button" href={`${import.meta.env.BASE_URL}contact/`}><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M2.5 6.5A2.5 2.5 0 0 1 5 4h14a2.5 2.5 0 0 1 2.5 2.5v11A2.5 2.5 0 0 1 19 20H5a2.5 2.5 0 0 1-2.5-2.5zm1.8-.7 7.7 6.1 7.7-6.1"/></svg>Email Me</a>
      </div>
      <div class="home-social-links" aria-label="Connect online">
        <a href="https://github.com/Tech-Galary/" target="_blank" rel="noreferrer" aria-label="TechGalary GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.07c-3.1.67-3.75-1.32-3.75-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.76 2.06 3.64 1.57.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.11-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.29-2.61 5.23-5.1 5.51.4.35.75 1.03.75 2.08V22c0 .29.2.63.76.52A11.1 11.1 0 0 0 12 .9Z"/></svg></a>
        <a href="https://www.linkedin.com/in/sowmya-n-80931663/" target="_blank" rel="noreferrer" aria-label="LinkedIn profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3.5a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4ZM3.3 9.5h3.8V21H3.3zM9.2 9.5h3.6v1.6h.1a4 4 0 0 1 3.6-2c3.9 0 4.6 2.5 4.6 5.7V21h-3.8v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21H9.2z"/></svg></a>
        <a href="https://www.youtube.com/@techgalary/" target="_blank" rel="noreferrer" aria-label="TechGalary YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6z"/></svg></a>
        <a href="mailto:sowmyanx@gmail.com" aria-label="Email Sowmya"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h18v13H3zM3.5 6l8.5 6.5L20.5 6"/></svg></a>
      </div>
    </div>
  </section>

</BaseLayout>
