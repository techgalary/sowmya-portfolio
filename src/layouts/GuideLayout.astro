---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} | Sowmya Narayan`} description={frontmatter.description} active="guides">
  <article class="guide-article">
    <a class="back-link" href="/guides/">← All guides</a>
    <p class="eyebrow">/ guides / {frontmatter.category || 'engineering'}</p>
    <h1>{frontmatter.title}</h1>
    <p class="article-description">{frontmatter.description}</p>
    <div class="prose"><slot /></div>
    <div class="article-end"><span class="status-dot"></span> End of guide <a href="/guides/">Browse more notes ↗</a></div>
  </article>
</BaseLayout>
