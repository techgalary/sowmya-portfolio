---
import '../styles/global.css';
const {
  title = 'Sowmya Narayan | Platform Engineer',
  description = 'Senior Platform Engineer focused on cloud-native infrastructure, Kubernetes, Terraform, GitOps, and reliability.',
  active = ''
} = Astro.props;
const links = [
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/skills/', label: 'Skills', key: 'skills' },
  { href: '/projects/', label: 'Projects', key: 'projects' },
  { href: '/blog/', label: 'Blog', key: 'blog' }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071725" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Sowmya Narayan homepage">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" focusable="false">
              <ellipse class="cloud-orbit" cx="24" cy="24" rx="20" ry="12" />
              <path class="cloud-outline" d="M12.5 28.5h22a7 7 0 0 0 .2-14 11.2 11.2 0 0 0-21.1 2.8 5.7 5.7 0 0 0-1.1 11.2Z" />
              <path class="container-outline" d="M17 25.5h14.5v10H17z" />
              <path class="container-line" d="M17 29h14.5M21.8 25.5v10M26.7 25.5v10" />
            </svg>
          </span><span class="brand-name">Sowmya Narayan</span>
        </a>
        <nav aria-label="Main navigation">
          {links.map((link) => (
            <a class:list={['nav-link', { active: active === link.key }]} href={link.href}>{link.label}</a>
          ))}
          <a class="nav-cta nav-github" href="https://github.com/Tech-Galary/" target="_blank" rel="noopener noreferrer" aria-label="Open Tech-Galary GitHub in a new tab"><span class="nav-github-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.776.418-1.305.762-1.605-2.665-.304-5.467-1.332-5.467-5.93 0-1.31.468-2.38 1.235-3.22-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.3 1.23a11.49 11.49 0 0 1 6.006 0c2.29-1.552 3.296-1.23 3.296-1.23.654 1.653.243 2.873.12 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.807 5.622-5.48 5.92.43.372.815 1.103.815 2.222 0 1.604-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.597 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </span> GitHub</a>
          <a class="nav-cta nav-book" href="/consultation/" target="_blank" rel="noopener noreferrer"><span class="book-session-icon" aria-hidden="true">↗</span> Book Session</a>
        </nav>
      </header>
      <main><slot /></main>
      <section class="support-card" aria-label="Support my work">
        <div class="support-terminal">
          <div class="support-window-dots"><i></i><i></i><i></i></div>
          <p class="support-command"><span>sowmya@techgalary</span>:<b>~/community</b>$ support-the-work</p>
          <p class="support-success">✳ Sharing practical cloud-native learning</p>
          <p class="support-copy">If my guides or projects help you, explore TechGalary and connect with me. Community feedback and collaboration help me keep learning and sharing.</p>
          <a class="support-button" href="https://www.youtube.com/@techgalary/" target="_blank" rel="noreferrer">↗ &nbsp; Visit TechGalary on YouTube <span>↗</span></a>
        </div>
      </section>
      <footer class="footer terminal-footer">
        <div class="footer-terminal-content">
          <p class="footer-command"><span>sowmya@cloud-platform</span>:<b>~</b>$ <strong>whoami</strong></p>
          <p class="footer-output">Senior Platform / DevOps Engineer · AWS · Azure · Google Cloud · Kubernetes</p>
          <p class="footer-command"><span>sowmya@cloud-platform</span>:<b>~</b>$ <strong>focus</strong></p>
          <p class="footer-output">Automate thoughtfully. Monitor continuously. Keep learning.</p>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Sowmya Narayan</span><span><a href="mailto:sowmyanx@gmail.com">Email</a> · <a href="https://www.linkedin.com/in/sowmya-n-80931663/" target="_blank" rel="noreferrer">LinkedIn</a> · <a href="https://github.com/Tech-Galary/" target="_blank" rel="noreferrer">GitHub</a></span></div>
      </footer>
    </div>
  </body>
</html>
